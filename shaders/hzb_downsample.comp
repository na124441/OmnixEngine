#version 450
layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D previousMip;
layout(set = 0, binding = 1, r32f) uniform image2D currentMip;

layout(push_constant) uniform PushConstants
{
    ivec2 currentMipSize;
} pc;

void main()
{
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= pc.currentMipSize.x || coord.y >= pc.currentMipSize.y)
    {
        return;
    }

    ivec2 src = coord * 2;
    float d0 = texelFetch(previousMip, src + ivec2(0, 0), 0).r;
    float d1 = texelFetch(previousMip, src + ivec2(1, 0), 0).r;
    float d2 = texelFetch(previousMip, src + ivec2(0, 1), 0).r;
    float d3 = texelFetch(previousMip, src + ivec2(1, 1), 0).r;

    // Minimum depth (standard depth representation: 0 near, 1 far)
    float reduced = min(min(d0, d1), min(d2, d3));
    imageStore(currentMip, coord, vec4(reduced));
}
