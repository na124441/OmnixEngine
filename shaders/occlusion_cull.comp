#version 450
layout(local_size_x = 64) in;

struct GPUInstance
{
    mat4 worldMatrix;
    mat4 previousWorldMatrix;
    vec4 boundsCenterRadius;
    uint meshIndex;
    uint materialIndex;
    uint objectID;
    uint flags;
};

layout(std430, set = 0, binding = 0) readonly buffer InstanceBuffer
{
    GPUInstance instances[];
};

layout(std430, set = 0, binding = 1) readonly buffer FrustumVisibleInstanceBuffer
{
    uint frustumVisibleInstances[];
};

layout(std430, set = 0, binding = 2) readonly buffer FrustumVisibleCountBuffer
{
    uint frustumVisibleCount;
};

layout(set = 0, binding = 3) uniform CameraUBO
{
    mat4 view;
    mat4 projection;
    mat4 inverseView;
    mat4 inverseProjection;
    vec4 cameraPosition;
    vec4 viewportSize; // xy = size, zw = 1.0/size
} camera;

layout(set = 0, binding = 4) uniform sampler2D hzbTexture;

layout(std430, set = 0, binding = 5) writeonly buffer FinalVisibleInstanceBuffer
{
    uint finalVisibleInstances[];
};

layout(std430, set = 0, binding = 6) buffer FinalVisibleCountBuffer
{
    uint finalVisibleCount;
};

layout(std430, set = 0, binding = 7) buffer OcclusionCullStatsBuffer
{
    uint occlusionCulledCount;
};

layout(push_constant) uniform OcclusionCullPushConstants
{
    uint maxInstanceCount;
    uint frustumOnlyMode; // 1 if we should skip occlusion check and just copy
    float depthBias;
} pc;

void main()
{
    uint gId = gl_GlobalInvocationID.x;
    if (gId >= frustumVisibleCount)
    {
        return;
    }

    uint instanceIndex = frustumVisibleInstances[gId];
    GPUInstance instance = instances[instanceIndex];
    if ((instance.flags & 1) == 0)
    {
        return;
    }
    // Skip virtual geometry instances
    if ((instance.flags & 4) != 0)
    {
        return;
    }
    vec3 center = instance.boundsCenterRadius.xyz;
    float radius = instance.boundsCenterRadius.w;

    if (pc.frustumOnlyMode != 0)
    {
        // Just bypass occlusion culling
        uint outIndex = atomicAdd(finalVisibleCount, 1);
        finalVisibleInstances[outIndex] = instanceIndex;
        return;
    }

    // Compute scaled radius in world space
    float scaleX = length(instance.worldMatrix[0].xyz);
    float scaleY = length(instance.worldMatrix[1].xyz);
    float scaleZ = length(instance.worldMatrix[2].xyz);
    float worldRadius = radius * max(scaleX, max(scaleY, scaleZ));

    // Transform center to view space
    vec4 viewCenter = camera.view * instance.worldMatrix * vec4(center, 1.0);

    // If sphere intersects or is behind the near plane, project conservatively or mark visible
    if (viewCenter.z + worldRadius >= -0.1)
    {
        uint outIndex = atomicAdd(finalVisibleCount, 1);
        finalVisibleInstances[outIndex] = instanceIndex;
        return;
    }

    // Form the 8 corners of the view-space bounding box of the sphere
    vec3 viewMin = viewCenter.xyz - vec3(worldRadius);
    vec3 viewMax = viewCenter.xyz + vec3(worldRadius);

    vec3 corners[8];
    corners[0] = vec3(viewMin.x, viewMin.y, viewMin.z);
    corners[1] = vec3(viewMax.x, viewMin.y, viewMin.z);
    corners[2] = vec3(viewMin.x, viewMax.y, viewMin.z);
    corners[3] = vec3(viewMax.x, viewMax.y, viewMin.z);
    corners[4] = vec3(viewMin.x, viewMin.y, viewMax.z);
    corners[5] = vec3(viewMax.x, viewMin.y, viewMax.z);
    corners[6] = vec3(viewMin.x, viewMax.y, viewMax.z);
    corners[7] = vec3(viewMax.x, viewMax.y, viewMax.z);

    vec2 minUV = vec2(1.0);
    vec2 maxUV = vec2(0.0);
    
    for (int i = 0; i < 8; ++i)
    {
        vec4 projected = camera.projection * vec4(corners[i], 1.0);
        if (projected.w > 0.0)
        {
            vec3 ndc = projected.xyz / projected.w;
            vec2 uv = ndc.xy * 0.5 + 0.5;
            uv.y = 1.0 - uv.y; // Flip Y for Vulkan
            minUV = min(minUV, uv);
            maxUV = max(maxUV, uv);
        }
    }

    minUV = clamp(minUV, vec2(0.0), vec2(1.0));
    maxUV = clamp(maxUV, vec2(0.0), vec2(1.0));

    // Calculate footprint size in pixels
    vec2 boxSize = (maxUV - minUV) * camera.viewportSize.xy;
    float boxWidth = max(boxSize.x, boxSize.y);

    // Determine HZB mip level based on screen-space footprint (width of bounding box)
    float mip = max(0.0, ceil(log2(boxWidth)) - 1.0);

    // Clamp mip level to maximum mips of HZB
    float maxMip = float(textureQueryLevels(hzbTexture) - 1);
    mip = min(mip, maxMip);

    // Sample HZB at the 4 corners of the projected screen bounding box
    float hzb0 = textureLod(hzbTexture, vec2(minUV.x, minUV.y), mip).r;
    float hzb1 = textureLod(hzbTexture, vec2(maxUV.x, minUV.y), mip).r;
    float hzb2 = textureLod(hzbTexture, vec2(minUV.x, maxUV.y), mip).r;
    float hzb3 = textureLod(hzbTexture, vec2(maxUV.x, maxUV.y), mip).r;

    // Standard Z (0 near, 1 far): Furthest depth is the maximum depth
    float hzbDepth = max(max(hzb0, hzb1), max(hzb2, hzb3));

    // Nearest point of sphere depth in NDC (standard Vulkan: 0 = near, 1 = far)
    vec4 closestView = viewCenter;
    closestView.z += worldRadius; // moving closer to camera (which is at 0)
    vec4 closestClip = camera.projection * closestView;
    float sphereDepth = closestClip.z / closestClip.w;

    // Occlusion check
    if (sphereDepth > hzbDepth + pc.depthBias)
    {
        // Occluded!
        atomicAdd(occlusionCulledCount, 1);
    }
    else
    {
        // Visible!
        uint outIndex = atomicAdd(finalVisibleCount, 1);
        finalVisibleInstances[outIndex] = instanceIndex;
    }
}
